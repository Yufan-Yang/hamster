<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>site.shiguang.compute</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DIR__/.venv/bin/python</string>
    <string>__DIR__/mac_worker.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/Homebrew/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- below what you're doing on the Mac, but not throttled to the efficiency cores like ProcessType Background -->
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>__DIR__/worker.log</string>
  <key>StandardErrorPath</key><string>__DIR__/worker.log</string>
</dict>
</plist>

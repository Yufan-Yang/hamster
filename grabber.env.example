# Template for /etc/grabber.env on the Pi (the real file holds the keys and is never committed)

# Where things live: media library (mergerfs pool), state (models, temp, wake-up sockets), the database (on a disk,
# not the SD card: SQLite writes all day)
MEDIA_ROOT=/mnt/media
STATE_DIR=/var/lib/grabber
DB_PATH=/mnt/disk1/.grabber/grabber.db

# Page: LAN port, and a second "external" port (login required, no sign-up) for a tunnel if you have one
PORT=8088
EXTERNAL_PORT=8090
# Password of the "admin" account
GRABBER_PASSWORD=

# LLM for sorting, summaries, chapters, translation, search: any OpenAI-compatible API (empty: no AI features)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_EFFORT=low
# Language for summaries, key points and tags
SUMMARY_LANG=Simplified Chinese

# Speech-to-text on the Pi: a quick sample when a download is classified (minutes from start/middle/end), full
# subtitles when the Mac isn't around, and 随记 voice notes
WHISPER_MODEL=base
TRANSCRIBE_MAX_MIN=6
IDLE_WHISPER_MODEL=small
NOTE_WHISPER_MODEL=small
# 0: the Pi never does CPU tasks itself (they wait for the Mac)
IDLE_WORK=1

# Downloads: H.264/AAC up to 1080p so phones and Plex play them directly (the Pi can't transcode well)
YTDLP_FORMAT_SORT=vcodec:h264,res:1080,acodec:aac,ext:mp4:m4a
DOWNLOAD_WORKERS=4
# Proxies yt-dlp retries through when a site blocks the first (space-separated)
YTDLP_EXITS=

# 追更: how often followed uploaders are checked, how many older videos the first check takes, download slots
SUB_INTERVAL=604800
SUB_BACKFILL=50
SUB_WORKERS=2

# Shared secret of the Mac compute worker (same value as ~/shiguang-compute/token on the Mac)
COMPUTE_TOKEN=

# Plex token so finished downloads show up right away
PLEX_TOKEN=

# Telegram bot (off; a token from @BotFather turns it on)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED=

# public https address (reverse tunnel), e.g. https://example.org:8443: the iOS shortcut for outside posts there
PUBLIC_URL=

# LLM for summaries + auto-sorting, any OpenAI-compatible API (leave key empty for basic filename/metadata sorting)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Language for summaries, key points and tags
SUMMARY_LANG=Simplified Chinese
# Telegram bot (off for now; set a token from @BotFather to turn it on)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED=
# Speech-to-text for videos without subtitles: Whisper model and minutes of audio (sampled from start/middle/end)
WHISPER_MODEL=base
TRANSCRIBE_MAX_MIN=6
# yt-dlp format preference: H.264/AAC up to 1080p, so phones and Plex play it directly (the Pi can't transcode well)
YTDLP_FORMAT_SORT=vcodec:h264,res:1080,acodec:aac,ext:mp4:m4a
DOWNLOAD_WORKERS=4
PORT=8088
# Plex token so finished downloads show up right away (filled in on the Pi)
PLEX_TOKEN=

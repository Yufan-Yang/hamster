[Unit]
Description=拾光 web page and API (grabber)
After=network-online.target mnt-media.mount xray-tproxy.service
Wants=network-online.target
RequiresMountsFor=/mnt/media

[Service]
User=grabber
Group=media
UMask=0002
EnvironmentFile=-/etc/grabber.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/grabber/venv/bin/python /opt/grabber/grabber.py web
Nice=5
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
